{
  "name": "personal-portfolio-platform",
  "version": "1.0.0",
  "description": "Personal portfolio platform with personalSite, Server, and portfolio submodules",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:personalSite\" \"npm run dev:server\"",
    "devp": "concurrently \"npm run dev:portfolio\" \"npm run dev:server\"",
    "dev:personalSite": "cd personalSite && npm run dev",
    "dev:server": "cd Server && npm run dev",
    "dev:frontend": "npm run dev:personalSite",
    "dev:backend": "npm run dev:server",
    "dev:portfolio": "cd portfolio && npm run dev",
    "build": "cd personalSite && npm run build",
    "build:portfolio": "cd portfolio && npm run build",
    "start": "cd Server && npm start"
  },
  "keywords": [
    "portfolio",
    "react",
    "typescript",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
